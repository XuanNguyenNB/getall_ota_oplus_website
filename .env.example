# Prefer ENVIRONMENT. APP_ENV is still accepted as a legacy alias.
ENVIRONMENT=local
LOG_LEVEL=INFO

# Offline defaults; switch all three values together for a live server runtime.
REPOSITORY_BACKEND=memory
OTA_PROVIDER=fake
ALLOW_LIVE_OTA=false

# Server-only values required when REPOSITORY_BACKEND=supabase.
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_SECRET_KEY=
# Browser-safe publishable/anon key. Required only for the /admin login page
# (Supabase Auth runs client-side; RLS + admin_users still gate every action).
SUPABASE_ANON_KEY=

RUI_CANDIDATES=8,7,6
REALME_OTA_TIMEOUT_SECONDS=30
SCAN_MAX_CONCURRENCY=3
SCAN_CYCLE_DAYS=7
SCAN_MAX_TASKS_PER_RUN=
SCAN_REQUEST_INTERVAL_SECONDS=1
SCAN_FAILURE_RATE_THRESHOLD=0.10
SCAN_FAILURE_ARCHIVE_THRESHOLD=3
SCAN_TIMEOUT_RETRIES=1
ENABLE_RAW_RESPONSE=false

# Public mode requires Cloudflare Tunnel/WAF in deployment and these server-side controls.
PUBLIC_SITE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
PUBLIC_RATE_LIMIT_SALT=
CLOUDFLARE_TUNNEL_TOKEN=
OTA_PUBLIC_CACHE_TTL_SECONDS=1800
OTA_PUBLIC_RATE_LIMIT_PER_HOUR=5
RESOLVER_PUBLIC_RATE_LIMIT_PER_HOUR=10

# Resolver remains blocked until a bounded live component-link proof is captured.
ENABLE_RESOLVER=false
RESOLVER_LIVE_PROOF_CONFIRMED=false
RESOLVER_ALLOWED_HOST_SUFFIXES=allawnofs.com,allawnos.com,allawntech.com,coloros.com,realmemobile.com,h2os.com
RESOLVER_TIMEOUT_SECONDS=30
RESOLVER_MAX_REDIRECTS=5

# Bot service values; leave empty unless running python -m ota_backend.telegram_bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_COMMAND_CHAT_ID=
TELEGRAM_WORKER_LOG_CHAT_ID=
TELEGRAM_ADMIN_USER_IDS=
TELEGRAM_POLL_TIMEOUT_SECONDS=20
TELEGRAM_NOTIFICATION_MAX_ATTEMPTS=3
TELEGRAM_NOTIFICATION_RETRY_SECONDS=300
TELEGRAM_WORKER_LOGS_ENABLED=false
TELEGRAM_WORKER_LOG_RELEASE_LIMIT=10
