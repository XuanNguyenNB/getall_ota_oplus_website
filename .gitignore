# Harness durable layer — each project instance generates its own data.
harness.db
harness.db-wal
harness.db-shm

# Server-only runtime configuration and secrets.
.env
.env.*
!.env.example

# Rust build output for harness tooling.
target/
dist/

# Downloaded Harness CLI binary for installed project instances.
scripts/bin/harness-cli

# Downloaded Tailwind standalone CLI (re-fetched by scripts/build-css.*).
scripts/bin/tailwindcss
scripts/bin/tailwindcss.exe

# Local runtime/cache artifacts.
.harness-backup/
.pytest_cache/
tmp/
validation-artifacts/
uvicorn-*.log
__pycache__/

# Coverage + transient agent/automation artifacts.
.coverage
.codex/
.playwright-mcp/
archive_candidates.txt

# Local-only WebADB experiment, not part of the FastAPI app.
webadb-local/
